<?xml version="1.0" encoding="utf-8"?>
<!--
  Chemins exposés par le FileProvider ${applicationId}.fileprovider (AndroidManifest.xml).
  Seul Capacitor (BridgeWebChromeClient.createImageFile) s'en sert : la photo prise par la
  caméra depuis un <input type="file" capture> est écrite dans getExternalFilesDir(DIRECTORY_PICTURES).
  On n'expose donc que ce sous-dossier du stockage privé de l'application, et plus tout le
  stockage externe ni le cache (path="." du modèle Capacitor, Aikido).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="my_images" path="Pictures/" />
</paths>
